{
  "name": "gacha-trend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build --root web",
    "dev": "npm run build && wrangler dev --remote",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply gacha-trend-db --remote",
    "typecheck": "tsc --noEmit -p api/tsconfig.json"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "astro": "^5.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.135.0"
  }
}
