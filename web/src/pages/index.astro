<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Gacha Social Trend</title>
<script is:inline>
  (() => {
    const saved = localStorage.getItem("theme");
    const light = saved ? saved === "light" : matchMedia("(prefers-color-scheme: light)").matches;
    document.documentElement.classList.toggle("light", light);
  })();
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
:root{
  --bg:#0b0d12;--card:#141821;--card2:#1a1f2b;--line:#242b38;--txt:#e8eaf0;--mut:#8b94a7;
  --acc:#7c6cf0;--acc2:#22d3ee;--up:#4ade80;--down:#f87171;--hover:rgba(255,255,255,.045);
  --shadow:0 1px 2px rgba(0,0,0,.35),0 8px 24px -18px rgba(0,0,0,.6);
}
html.light{
  --bg:#f4f5f9;--card:#ffffff;--card2:#f8f9fc;--line:#e6e9f0;--txt:#111827;--mut:#5b6473;
  --acc:#6a5ae0;--acc2:#0891b2;--up:#15803d;--down:#dc2626;--hover:rgba(17,24,39,.04);
  --shadow:0 1px 2px rgba(16,24,40,.06),0 8px 24px -18px rgba(16,24,40,.25);
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--txt);line-height:1.45;
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;transition:background .2s,color .2s}
a{color:inherit}
.mut{color:var(--mut)}
.mono,.val,.row-val,td.num,th.num{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-variant-numeric:tabular-nums}

.top{position:sticky;top:0;z-index:20;background:var(--bg);border-bottom:1px solid var(--line)}
@supports (background:color-mix(in srgb,red 50%,blue)){
  .top{background:color-mix(in srgb,var(--bg) 82%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
}
.top-in{max-width:1320px;margin:0 auto;padding:0 24px;height:60px;display:flex;align-items:center;gap:12px}
.brand{display:flex;align-items:center;gap:9px;font-weight:700;letter-spacing:2px;font-size:13.5px}
.brand i{width:10px;height:10px;border-radius:50%;background:linear-gradient(135deg,var(--acc),var(--acc2));display:block;box-shadow:0 0 12px var(--acc)}
.ghost{margin-left:auto;background:transparent;color:var(--txt);border:1px solid var(--line);border-radius:10px;width:36px;height:36px;font-size:15px;cursor:pointer;transition:border-color .15s,transform .15s}
.ghost:hover{border-color:var(--acc);transform:translateY(-1px)}

.wrap{max-width:1320px;margin:0 auto;padding:30px 24px 60px}
@media(max-width:680px){.top-in,.wrap{padding-left:16px;padding-right:16px}}

.hd{display:flex;align-items:baseline;gap:26px;flex-wrap:wrap;margin-bottom:22px}
.hd h1{margin:0;font-size:22px;letter-spacing:-.02em}
.hd .stats{display:flex;gap:22px;flex-wrap:wrap;color:var(--mut);font-size:13px}
.hd .stats b{color:var(--txt);font-family:ui-monospace,monospace;font-variant-numeric:tabular-nums;margin-right:3px}

.toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;background:var(--card);border:1px solid var(--line);
  border-radius:14px;padding:12px 14px;margin-bottom:10px;box-shadow:var(--shadow)}
select,input,button{background:var(--bg);color:var(--txt);border:1px solid var(--line);border-radius:10px;padding:8px 12px;font:inherit;font-size:13.5px}
button{cursor:pointer;transition:border-color .15s,color .15s,background .15s}
button:hover{border-color:var(--acc)}
button.on{border-color:var(--acc);color:var(--acc);background:color-mix(in srgb,var(--acc) 12%,transparent)}
.status{color:var(--mut);font-size:12px;margin:0 2px 24px}

section{margin-bottom:28px}
.sec-hd{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin:0 2px 12px}
.sec-hd h2{margin:0;font-size:15px;font-weight:600;letter-spacing:-.01em}
.sec-hd .hint{color:var(--mut);font-size:12px}

.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;align-items:stretch}
@media(max-width:940px){.grid4{grid-template-columns:1fr 1fr}.grid3{grid-template-columns:1fr}}
@media(max-width:520px){.grid4{grid-template-columns:1fr}}

.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px 20px;box-shadow:var(--shadow)}
.grid4 .card,.grid3 .card{height:100%}
.card h3{margin:0;font-size:14px;font-weight:600}

/* --- stat cards --- */
.stat{display:flex;flex-direction:column}
.stat-top{display:flex;align-items:center;gap:9px;color:var(--mut);font-size:12px;font-weight:500}
.ic{width:27px;height:27px;border-radius:9px;display:grid;place-items:center;flex:none;
  background:var(--hover);color:var(--acc);border:1px solid var(--line)}
.ic svg{width:15px;height:15px}
.val{font-size:29px;font-weight:700;letter-spacing:-.025em;margin-top:10px}
.stat-foot{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--mut);margin-top:3px;flex-wrap:wrap}
.sparkwrap{margin-top:auto;padding-top:12px}
.spark{width:100%;height:34px;display:block;overflow:visible}

.dpill{display:inline-flex;align-items:center;gap:3px;padding:1px 7px;border-radius:999px;font-size:11px;font-weight:600}
.dpill.up{background:color-mix(in srgb,var(--up) 16%,transparent);color:var(--up)}
.dpill.down{background:color-mix(in srgb,var(--down) 16%,transparent);color:var(--down)}
.dpill.flat{background:var(--hover);color:var(--mut);font-weight:500}

/* --- panel rows (shared by buzz / platforms / games) --- */
.panel-hd{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.panel-hd h3{margin:0;font-size:14px;font-weight:600;line-height:1.2}
.panel-hd .sub{display:block;color:var(--mut);font-size:11px;font-weight:400}
.rows{display:flex;flex-direction:column;gap:1px}
.row{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;
  padding:8px 10px;margin:0 -10px;border-radius:10px;transition:background .15s}
.row:hover{background:var(--hover)}
.row.clickable{cursor:pointer}
.row-name{font-size:13.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row-val{text-align:right;font-size:13px;font-weight:600;line-height:1.25}
.row-sub{display:block;font-size:10.5px;color:var(--mut);font-weight:500}
.bar{height:5px;background:var(--line);border-radius:999px;overflow:hidden;margin-top:6px}
.bar>i{display:block;height:100%;border-radius:999px;background:var(--acc);transition:width .45s ease}
.pdot{width:9px;height:9px;border-radius:50%;flex:none;display:block}
.avatar{width:28px;height:28px;border-radius:9px;display:grid;place-items:center;flex:none;font-size:10.5px;
  font-weight:700;color:#fff;letter-spacing:.02em;background:linear-gradient(135deg,var(--a),var(--b))}

.glabel{font-size:10.5px;text-transform:uppercase;letter-spacing:.09em;color:var(--mut);margin:0 0 8px;font-weight:600}
.group+.group{margin-top:16px;padding-top:14px;border-top:1px solid var(--line)}
.chips{display:flex;flex-wrap:wrap;gap:7px}
.chip{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;
  background:var(--card2);border:1px solid var(--line);font-size:12px;transition:border-color .15s,transform .15s}
.chip:hover{border-color:var(--acc);transform:translateY(-1px)}
.chip b{font-family:ui-monospace,monospace;font-size:11px;color:var(--mut)}

/* --- chart --- */
.chartbox{position:relative;height:280px}
@media(max-width:640px){.chartbox{height:220px}}

/* --- table --- */
.tablewrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13.5px}
th,td{padding:11px 10px;text-align:left;border-bottom:1px solid var(--line)}
th{color:var(--mut);font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap}
tr:last-child td{border-bottom:none}
tbody tr{transition:background .15s}
tbody tr:hover{background:var(--hover)}
td.num,th.num{text-align:right;white-space:nowrap}
td a{text-decoration:none}
td a:hover{color:var(--acc)}
.rk{color:var(--mut);font-size:12px;text-align:right;width:28px}
.ttitle{display:flex;align-items:center;gap:12px;min-width:260px}
.ttitle a{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;max-width:560px}
.thumb{width:56px;height:32px;border-radius:7px;object-fit:cover;background:var(--line);flex:none;display:block}
.pill{display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border-radius:999px;
  background:var(--card2);border:1px solid var(--line);color:var(--mut);font-size:11px}
.empty{color:var(--mut);font-size:13px;padding:8px 0}
footer{max-width:1320px;margin:0 auto;padding:0 24px 36px;color:var(--mut);font-size:12px}
</style>
</head>
<body>
<header class="top">
  <div class="top-in">
    <div class="brand"><i></i> GACHA SOCIAL</div>
    <button id="theme" class="ghost" aria-label="Toggle color theme">☾</button>
  </div>
</header>

<main class="wrap">
  <div class="hd">
    <h1>Dashboard</h1>
    <div class="stats">
      <span><b id="hViews">–</b> tracked views</span>
      <span><b id="hPosts">–</b> posts</span>
      <span><b id="hGames">–</b> games</span>
      <span><b id="hPlats">–</b> platforms</span>
    </div>
  </div>

  <div class="toolbar">
    <select id="game"></select>
    <select id="days">
      <option value="7">Last 7 days</option>
      <option value="14">Last 14 days</option>
      <option value="30">Last 30 days</option>
    </select>
    <input id="q" placeholder="Filter games..." />
    <div id="filters" style="display:flex;gap:8px;flex-wrap:wrap"></div>
  </div>
  <p class="status" id="status">Loading…</p>

  <section>
    <div class="sec-hd"><h2>Snapshot</h2><span class="hint" id="snapHint"></span></div>
    <div class="grid4">
      <div class="card stat">
        <div class="stat-top"><span class="ic" data-ic="views"></span>Views</div>
        <div class="val" id="sViews">–</div>
        <div class="stat-foot" id="sViewsD"></div>
        <div class="sparkwrap" id="sViewsSpark"></div>
      </div>
      <div class="card stat">
        <div class="stat-top"><span class="ic" data-ic="likes"></span>Likes</div>
        <div class="val" id="sLikes">–</div>
        <div class="stat-foot" id="sLikesD"></div>
        <div class="sparkwrap" id="sLikesSpark"></div>
      </div>
      <div class="card stat">
        <div class="stat-top"><span class="ic" data-ic="eng"></span>Engagement rate</div>
        <div class="val" id="sEng">–</div>
        <div class="stat-foot" id="sEngD"></div>
      </div>
      <div class="card stat">
        <div class="stat-top"><span class="ic" data-ic="plat"></span>Most active platform</div>
        <div class="val" id="sPlat">–</div>
        <div class="stat-foot" id="sPlatD"></div>
      </div>
    </div>
  </section>

  <section>
    <div class="sec-hd"><h2>Trend</h2><span class="hint">daily gain: views (bars) · likes (line)</span></div>
    <div class="card">
      <div class="chartbox"><canvas id="chart"></canvas></div>
      <div class="empty" id="chartEmpty" style="display:none">Not enough history to compute a daily gain yet.</div>
    </div>
  </section>

  <section>
    <div class="grid3">
      <div class="card">
        <div class="panel-hd"><span class="ic" data-ic="buzz"></span><div><h3>Word buzz</h3><span class="sub">tracked keywords + top hashtags</span></div></div>
        <div id="buzz"></div>
      </div>
      <div class="card">
        <div class="panel-hd"><span class="ic" data-ic="plat"></span><div><h3>Platforms</h3><span class="sub">share of views in window</span></div></div>
        <div id="plats"></div>
      </div>
      <div class="card">
        <div class="panel-hd"><span class="ic" data-ic="game"></span><div><h3>Games</h3><span class="sub">7-day tracked views</span></div></div>
        <div id="games"></div>
      </div>
    </div>
  </section>

  <section>
    <div class="sec-hd"><h2>Top posts</h2><span class="hint" id="postsHint"></span></div>
    <div class="card"><div class="tablewrap"><table id="posts"></table></div></div>
  </section>
</main>
<footer>Data collected from official channels; estimates may lag. Updated daily 06:00 UTC.</footer>
<script src="/dashboard.js" type="module"></script>
</body>
</html>
